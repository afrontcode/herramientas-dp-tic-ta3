# Copiar como .env (junto a docker-compose.yml) y completar

# Usuario MQTT de Telegraf: crearlo en EMQX > Access Control > Authentication > Users
TELEGRAF_MQTT_USERNAME=telegraf
TELEGRAF_MQTT_PASSWORD=CAMBIAR_ESTA_CLAVE

# Token de administrador de InfluxDB (solo se aplica la primera vez que se crea el volumen)
INFLUX_TOKEN=CAMBIAR_TOKEN_LARGO_DE_LABORATORIO
