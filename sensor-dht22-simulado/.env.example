# Copiar como .env y completar con los datos reales
MQTT_HOST=localhost

# true = conexión cifrada por el puerto 8883 usando broker/certs/ca.crt
MQTT_USE_TLS=true
# MQTT_PORT=8883
# MQTT_CA_CERTS=../broker/certs/ca.crt

# Usuario creado en EMQX > Access Control > Authentication
MQTT_USERNAME=sensor_python
MQTT_PASSWORD=CAMBIAR_ESTA_CLAVE
